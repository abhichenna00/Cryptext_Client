{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NShroud",
  "version": "0.1.4",
  "identifier": "com.nshroud.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NShroud",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "splash",
        "title": "NShroud",
        "width": 300,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "url": "/splash"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob: http://asset.localhost; media-src 'self' blob: http://asset.localhost; connect-src 'self' https: wss: http://asset.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; worker-src 'none'; manifest-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media_cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nshroud"
        ]
      }
    },
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/abhichenna00/NShroud/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MTk4RDA0NDFERDU0RDkKUldUWlZOMUJCSTBaMXFCdHl2QWR3Mmx0bkZET3p1NFg3S0prRzY3SUZRc0VoUEdtL0ZCcCtPTkIK"
    }
  }
}