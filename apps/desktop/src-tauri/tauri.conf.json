{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cryptext",
  "version": "0.1.4",
  "identifier": "cryptex.app.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cryptext",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Cryptext",
        "width": 300,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "url": "/splash"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cryptex"
        ]
      }
    },
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/abhichenna00/Cryptext_Client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MTk4RDA0NDFERDU0RDkKUldUWlZOMUJCSTBaMXFCdHl2QWR3Mmx0bkZET3p1NFg3S0prRzY3SUZRc0VoUEdtL0ZCcCtPTkIK"
    }
  }
}