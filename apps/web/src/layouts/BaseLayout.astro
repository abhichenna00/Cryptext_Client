---
import '../styles/global.css'

interface Props {
	title: string
	description?: string
}

const {
	title,
	description = "End-to-end encrypted enterprise messaging on MLS (RFC 9420). Hosted on AWS, managed by our team — your keys never leave your device.",
} = Astro.props
---

<!doctype html>
<html lang="en" data-theme="dark" data-density="regular">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#08090A" />
		<link rel="icon" type="image/svg+xml" href="/NShroud-icon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
